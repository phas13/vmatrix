# DATABASE_URL is the single source of truth for the Postgres connection.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# For docker compose: host is the compose service name `postgres`.
# Rotation: update this value directly; the backend no longer composes it
# from POSTGRES_* parts. The postgres container reads
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB directly from this same
# URL via docker-compose.yml (parsed there, not here).
DATABASE_URL=postgresql+asyncpg://vmatrix_user:changeme_local@postgres:5432/vmatrix

# JWT signing key for access tokens. Use a long random secret in non-dev.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_long_random_secret

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet symmetric key used to encrypt sensitive field values at rest.
# MUST be 32 url-safe base64-encoded bytes, or the app refuses to start.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=9i-5Juy2gruo4M0LMe5nDDDEd40xBlm9Nhk-btgKOTI=

# LLM provider selection. One of: "claude" | "openai" | "gemini".
LLM_PROVIDER=claude

# Provider API keys. Leave blank for providers you do not use.
# WARNING: never commit real keys. This file is the template; real values
# live in `.env` which is gitignored.
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
